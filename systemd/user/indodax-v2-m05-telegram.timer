[Unit]
Description=Indodax V2 M05 dedicated Telegram 3-second owner polling
Documentation=https://github.com/dvoriano/indodax-ai-bot-v2/blob/main/docs/M05_DEDICATED_TELEGRAM_OPERATOR.md

[Timer]
# No scheduled burst catch-up. Each invocation holds the same SQLite lock.
OnStartupSec=3s
OnUnitInactiveSec=3s
AccuracySec=1s
Persistent=false
Unit=indodax-v2-m05-telegram.service

[Install]
WantedBy=timers.target
