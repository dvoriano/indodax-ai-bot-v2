[Unit]
Description=Indodax V2 M04 post-400m WATCH evidence collector (nonlive)

[Service]
Type=oneshot
WorkingDirectory=%h/indodax-ai-bot-v2
Environment=INDODAX_TRADING_ENABLED=NO
Environment=INDODAX_ALLOW_LIVE_EXECUTION=NO
Environment=INDODAX_EXECUTION_MODE=DRY_RUN
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
TimeoutStartSec=45s
ExecStart=%h/indodax-ai-bot-v2/.venv/bin/python -B -m scripts.m04_ws3_watch_post400_collector_nonlive --collect-once
