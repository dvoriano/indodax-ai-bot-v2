# M04-J STAGED ONLY. Do not install/enable without explicit operator action.
# User service, V2 repo only. PUBLIC MARKETDATA, no paid AI or orders.
# Restart ONLY after clean public-data batch exit0. Nonzero failure STOPS.
[Unit]
Description=Indodax AI Bot V2 PUBLIC BTC WebSocket collector (no trading)
# Deliberately no After=default.target: avoids ordering cycle in user manager.
# Each batch validates its own PUBLIC WS connectivity; failure stops the unit.
StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
Type=simple
WorkingDirectory=%h/indodax-ai-bot-v2
ExecStart=%h/indodax-ai-bot-v2/.venv/bin/python -B -m indodax_ai_bot --public-ws-supervised-once --pair btc_idr --db runtime/public_ws_btc.sqlite3 --collector-sessions 10 --stream-seconds 30 --collector-pause-seconds 1 --supervisor-status-file runtime/public_ws_btc.status.json
Environment=INDODAX_TRADING_ENABLED=NO
Environment=INDODAX_ALLOW_LIVE_EXECUTION=NO
Environment=INDODAX_EXECUTION_MODE=DRY_RUN
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Restart=on-success
RestartSec=15s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
