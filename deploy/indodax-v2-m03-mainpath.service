# M03 mainpath, STAGED / DISABLED. One ORIGINAL V2 source tree ONLY:
# %h/indodax-ai-bot-v2, no independent worktree and no second bot.
# Owner install+enable only after pinned canonical V2 main HEAD check,
# existing BTC WS read-only continuity and verified egress-IP budget.
# Do not update any running BTC WS service or active checkout to install.
# No private API, paid AI, source trust promotion, BUY or SELL.
[Unit]
Description=Indodax V2 M03 minute ticker casebook with periodic deep20 -> strict G1/M04 REJECT
ConditionPathExists=%h/indodax-ai-bot-v2/runtime/public_ws_btc.sqlite3
ConditionPathExists=%h/indodax-ai-bot-v2/indodax_ai_bot/__main__.py

[Service]
Type=oneshot
# Use exactly ONE original V2 checkout. Owner must PIN/VERIFY its HEAD
# before enabling a source release; scanner never deploys or checks out.
WorkingDirectory=%h/indodax-ai-bot-v2
# User timer never overlaps this unit; flock also blocks accidental concurrent
# direct starts. Exactly ONE scanner: ~3 GET/min light; every fifth minute
# original 20-deep path (~83 GET) with BTC read-only G1 gate and M04 REJECT.
# Counts are illustrative not a global IP-budget warranty; no missed-tick replay.
# Do not start/enable timer without owner IP-budget approval.
ExecStart=/usr/bin/flock -n %t/indodax-v2-m03-mainpath.lock %h/indodax-ai-bot-v2/.venv/bin/python -B -m indodax_ai_bot --scheduled-public-scanner-once --bulk-deep-limit 20 --bulk-min-volume-idr 150000000 --ws-db %h/indodax-ai-bot-v2/runtime/public_ws_btc.sqlite3 --db %h/indodax-ai-bot-v2/runtime/decisions.sqlite3
Environment=INDODAX_TRADING_ENABLED=NO
Environment=INDODAX_ALLOW_LIVE_EXECUTION=NO
Environment=INDODAX_EXECUTION_MODE=DRY_RUN
# Secure owner 0600 policy must exist and stay fresh; still STAGED DISABLED.
# Never claim this declares or measures every external shared-IP consumer.
Environment=INDODAX_M03_REQUIRE_EGRESS_ADMISSION=YES
Environment=INDODAX_M03_EGRESS_ADMISSION_FILE=%h/.config/indodax-ai-bot-v2/m03-egress-admission.json
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=55s
Restart=no
StandardOutput=journal
StandardError=journal
