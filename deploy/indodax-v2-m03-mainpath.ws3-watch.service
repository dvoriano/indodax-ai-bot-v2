# OPTIONAL M03 WS3 WATCH-ONLY replacement profile for the EXISTING ORIGINAL
# indodax-v2-m03-mainpath.service. Never enable it under a new unit name.
# Preserve the owner's existing canonical REST unit as a private backup.
# The existing indodax-v2-m03-mainpath.timer stays unchanged.
#
# This is not full REST all-IDR scanner, DEEP20, depth/bid/ask, verified G1
# or owner-approved BUY/SELL. One official public WS3 summary connection
# for 40 seconds per minute; no private key and no REST GET.
[Unit]
Description=Indodax V2 original M03 WS3 summary WATCH only (REST HTTP403 alternate)
ConditionPathExists=%h/indodax-ai-bot-v2/indodax_ai_bot/m03_ws_summary_live_watch.py

[Service]
Type=oneshot
WorkingDirectory=%h/indodax-ai-bot-v2
ExecStart=/usr/bin/flock -n %t/indodax-v2-m03-mainpath.lock %h/indodax-ai-bot-v2/.venv/bin/python -B -m indodax_ai_bot --m03-ws-summary-watch-once --m03-ws-observe-seconds 40 --db %h/indodax-ai-bot-v2/runtime/decisions.sqlite3
Environment=INDODAX_TRADING_ENABLED=NO
Environment=INDODAX_ALLOW_LIVE_EXECUTION=NO
Environment=INDODAX_EXECUTION_MODE=DRY_RUN
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=70s
Restart=no
StandardOutput=journal
StandardError=journal
